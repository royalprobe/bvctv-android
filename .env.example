# deploy_update.py – Umgebungsvariablen
# Kopiere diese Datei nach .env und fülle die echten Werte ein.
# .env darf NICHT ins Git-Repo committed werden (in .gitignore eintragen).

# Personal Access Token von https://github.com/settings/tokens
# Benötigte Scopes: repo (für public Repos reicht public_repo)
GITHUB_TOKEN=ghp_DEIN_TOKEN_HIER

# Dein GitHub-Benutzername
GITHUB_USERNAME=dein_username

# Name des GitHub-Repos (nur der Repo-Name, nicht die volle URL)
GITHUB_REPO=dein-repo-name
